# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (MySQL)
MYSQL_DATABASE=online_quiz_db
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=quizuser
MYSQL_PASSWORD=quizpassword
MYSQL_LOCAL_PORT=3306

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/online_quiz_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword

# JWT Security
JWT_SECRET=dGhpc0lzQVZlcnlTZWN1cmVTZWNyZXRLZXlGb3JPbmxpbmVRdWl6QXBwbGljYXRpb24yMDI2IQ==
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Email Notifications (Optional)
MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@example.com
SPRING_MAIL_PASSWORD=secretpassword
